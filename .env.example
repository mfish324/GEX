# Data Provider Selection
# Choose: 'alpaca' or 'polygon'
DATA_PROVIDER=polygon

# Alpaca API Credentials (if using Alpaca)
# Get your API keys from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Polygon.io API Credentials (if using Polygon)
# Get your free API key from: https://polygon.io/
# Free tier: 5 API calls/minute
POLYGON_API_KEY=your_polygon_api_key_here

# Optional: Enable debug logging
DEBUG=false
